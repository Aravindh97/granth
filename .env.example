# Used by docker-compose.yml and by `granth` (export these in your shell).
POSTGRES_PASSWORD=
# OpenSearch requires a strong password (upper, lower, digit, symbol, 8+ chars).
OPENSEARCH_PASSWORD=

DATABASE_URL=postgres://granth:${POSTGRES_PASSWORD}@127.0.0.1:5432/granth?sslmode=disable
GRANTH_OPENSEARCH_URL=https://127.0.0.1:9200
OPENSEARCH_USER=admin
# The dev cluster uses a self-signed certificate. Prefer OPENSEARCH_CA_CERT=/path/root-ca.pem;
# set this only for the local docker cluster.
OPENSEARCH_INSECURE_SKIP_VERIFY=true
TEMPORAL_ADDRESS=127.0.0.1:7233
GRANTH_BLOB_DIR=./.blobs

# Optional: any OpenAI-compatible embeddings endpoint. Without it a local
# hashing embedder is used (lexical, offline, not semantic).
# EMBED_URL=http://127.0.0.1:8080/v1/embeddings
# EMBED_MODEL=intfloat/multilingual-e5-small
# EMBED_DIM=384
# EMBED_API_KEY=
